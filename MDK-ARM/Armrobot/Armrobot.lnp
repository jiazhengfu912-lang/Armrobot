--cpu Cortex-M3
"armrobot\startup_stm32f103xb.o"
"armrobot\main.o"
"armrobot\gpio.o"
"armrobot\usart.o"
"armrobot\stm32f1xx_it.o"
"armrobot\stm32f1xx_hal_msp.o"
"armrobot\stm32f1xx_hal_gpio_ex.o"
"armrobot\stm32f1xx_hal_tim.o"
"armrobot\stm32f1xx_hal_tim_ex.o"
"armrobot\stm32f1xx_hal_uart.o"
"armrobot\stm32f1xx_hal.o"
"armrobot\stm32f1xx_hal_rcc.o"
"armrobot\stm32f1xx_hal_rcc_ex.o"
"armrobot\stm32f1xx_hal_gpio.o"
"armrobot\stm32f1xx_hal_dma.o"
"armrobot\stm32f1xx_hal_cortex.o"
"armrobot\stm32f1xx_hal_pwr.o"
"armrobot\stm32f1xx_hal_flash.o"
"armrobot\stm32f1xx_hal_flash_ex.o"
"armrobot\stm32f1xx_hal_exti.o"
"armrobot\system_stm32f1xx.o"
"armrobot\app_control.o"
"armrobot\htd85h_servo.o"
"armrobot\pushrod.o"
--strict --scatter "Armrobot\Armrobot.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "Armrobot.map" -o Armrobot\Armrobot.axf